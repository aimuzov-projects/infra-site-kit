---
// Счётчик Яндекс Метрики. Ставится в <head>: он добавляет в CSP страницы свой хеш
// и источники Яндекса, а Astro пишет CSP-<meta> после содержимого head,
// то есть из <body> уже поздно. Пиксель для посетителей без JS -- metrika-pixel.astro.
import { metrikaCsp, metrikaScript, scriptHash } from './metrika.js'

type Props = {
	/** Номер счётчика в Яндекс Метрике. */
	id: number
	/** Опции инициализации ym поверх значений по умолчанию, например `{ webvisor: true }`. */
	init?: Record<string, unknown>
}

const { id, init } = Astro.props
const code = metrikaScript(id, init)

Astro.csp?.insertScriptHash(scriptHash(code))
for (const resource of metrikaCsp.scriptResources) Astro.csp?.insertScriptResource(resource)
for (const directive of metrikaCsp.directives) Astro.csp?.insertDirective(directive)
---

<script is:inline set:html={code} />
