---
// Общая страница "Что нового": оглавление по релизам и раздел на релиз. Обёртку (Base, шапку,
// подвал) рисует сайт, цвета и отступы приходят его CSS-переменными.
import { itemHtml, releaseDate, releaseId, visibleReleases } from './changelog.js'

type Release = import('./changelog.js').Release

type Props = {
	releases: Release[]
	/** SVG по имени иконки записи: `import * as lucide from 'lucide-static'` и свои. */
	icons?: Record<string, string>
	/** Заголовок `<h1>`, `false` -- сайт рисует его сам. */
	title?: string | false
	/** Абзац под заголовком. */
	lead?: string
	/** Подпись оглавления. */
	toc?: string | false
	/** Подпись версии в строке под заголовком раздела. */
	versionLabel?: string
	locale?: string
	class?: string
}

const {
	releases,
	icons = {},
	title = 'Что нового',
	lead,
	toc = 'Релизы',
	versionLabel = 'версия',
	locale = 'ru-RU',
	class: className,
} = Astro.props

const sections = visibleReleases(releases).map((r) => ({
	...r,
	id: releaseId(r.version),
	svg: r.icon ? icons[r.icon] : undefined,
}))
---

<div class:list={['changelog', className]}>
	{
		(title || lead) && (
			<header class="changelog__hero">
				{title && <h1 class="changelog__title">{title}</h1>}
				{lead && <p class="changelog__lead">{lead}</p>}
				<slot name="hero" />
			</header>
		)
	}

	<div class="changelog__layout">
		{
			toc && sections.length > 1 && (
				<nav class="changelog__toc" aria-label={toc}>
					<ol class="changelog__toc-list">
						{sections.map((s) => (
							<li>
								<a class="changelog__toc-link" href={`#${s.id}`}>
									{s.svg && <span class="changelog__icon" aria-hidden="true" set:html={s.svg} />}
									{s.title}
								</a>
							</li>
						))}
					</ol>
				</nav>
			)
		}

		<div class="changelog__body">
			{
				sections.map((s) => (
					<section class="changelog__release" id={s.id} aria-labelledby={`${s.id}-title`}>
						<h2 class="changelog__release-title" id={`${s.id}-title`}>
							{s.svg && <span class="changelog__icon" aria-hidden="true" set:html={s.svg} />}
							{s.title}
						</h2>
						<p class="changelog__meta">
							<time datetime={s.date}>{releaseDate(s.date, locale)}</time> · {versionLabel} {s.version}
						</p>
						<ul class="changelog__items">
							{s.items.map((item) => (
								<li set:html={itemHtml(item)} />
							))}
						</ul>
					</section>
				))
			}
		</div>
	</div>
</div>

<style>
	.changelog {
		--changelog-muted-color: var(--changelog-muted, color-mix(in srgb, currentColor 65%, transparent));

		max-width: var(--changelog-width, 64rem);
		margin: 0 auto;
		padding: var(--changelog-padding, 2rem 1rem);

		&__hero {
			max-width: 42rem;
			margin-bottom: 2rem;
		}

		&__title {
			margin: 0;
			font-size: clamp(1.75rem, 5vw, 2.5rem);
			line-height: 1.15;
			text-wrap: balance;
		}

		&__lead {
			margin: 0.75rem 0 0;
			color: var(--changelog-muted-color);
			text-wrap: pretty;
		}

		&__layout {
			display: grid;
			gap: 2rem;

			@media (width >= 56rem) {
				grid-template-columns: 14rem minmax(0, 1fr);
				align-items: start;
			}
		}

		&__toc {
			@media (width >= 56rem) {
				position: sticky;
				top: var(--changelog-sticky-top, 1rem);
			}
		}

		&__toc-list {
			display: grid;
			gap: 0.25rem;
			margin: 0;
			padding: 0;
			list-style: none;
		}

		&__toc-link {
			display: flex;
			gap: 0.5rem;
			align-items: center;
			padding: 0.25rem 0;
			color: var(--changelog-muted-color);
			text-decoration: none;

			&:hover,
			&:focus-visible {
				color: var(--changelog-accent, currentColor);
			}
		}

		&__body {
			display: grid;
			gap: 2.5rem;
			max-width: 42rem;
		}

		&__release {
			scroll-margin-top: var(--changelog-sticky-top, 1rem);
		}

		&__release-title {
			display: flex;
			gap: 0.5rem;
			align-items: center;
			margin: 0;
			font-size: 1.375rem;
			line-height: 1.25;
		}

		&__icon {
			display: inline-flex;
			flex: none;
			color: var(--changelog-accent, currentColor);

			& :global(svg) {
				width: 1.1em;
				height: 1.1em;
			}
		}

		&__meta {
			margin: 0.25rem 0 0.75rem;
			font-size: 0.875rem;
			color: var(--changelog-muted-color);
		}

		&__items {
			display: grid;
			gap: 0.5rem;
			margin: 0;
			padding-left: 1.25rem;

			& :global(a) {
				color: var(--changelog-accent, currentColor);
				text-underline-offset: 0.2em;
			}
		}
	}
</style>
