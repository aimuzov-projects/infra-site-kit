---
// Пиксель счётчика Метрики для посетителей без JavaScript. Ставится в <body>,
// потому что <img> внутри <noscript> в <head> не допускается.
// img-src для него добавляет metrika.astro.
import { metrikaPixel } from './metrika.js'

type Props = {
	/** Номер счётчика в Яндекс Метрике, тот же, что в metrika.astro. */
	id: number
}
---

<noscript>
	<div>
		<img src={metrikaPixel(Astro.props.id)} style="position:absolute; left:-9999px;" alt="" />
	</div>
</noscript>
