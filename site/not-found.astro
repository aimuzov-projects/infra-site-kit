---
// Общая 404: "4" лицо "4", заголовок, кнопки и подсказки по sitemap. Обёртку (Base, шапку,
// подвал, высоту `<main>`) рисует сайт, цвета и радиусы приходят его CSS-переменными.
import { MARK, MARK_VIEWBOX } from './mark.js'

type Props = {
	/** Заголовок `<h1>`. */
	title?: string
	/** Абзац под заголовком. Дополнительный текст -- в слот по умолчанию. */
	text?: string
	/** Ссылка на главную. */
	home?: { href: string; label: string }
	/** Подпись "Назад", `false` убирает кнопку. Видна, только когда человек пришёл с этого же сайта. */
	back?: string | false
	/** Заголовок подсказок, `false` убирает их вместе с запросом sitemap. */
	suggest?: string | false
	/** Индекс sitemap, из которого берутся подсказки. */
	sitemap?: string
	/** Префикс, под которым ищутся подсказки, например `/ru/` у русской 404. */
	scope?: string
	/** Префиксы, которые в подсказки не попадают, например `['/ru/']` у английской 404. */
	exclude?: string[]
	class?: string
}

const {
	title = 'Такой страницы нет',
	text = 'Возможно, ссылка устарела или в ней опечатка.',
	home = { href: '/', label: 'На главную' },
	back = 'Назад',
	suggest = 'Возможно, вы искали',
	sitemap = '/sitemap-index.xml',
	scope,
	exclude,
	class: className,
} = Astro.props
---

<div
	class:list={['not-found', className]}
	data-not-found
	data-sitemap={suggest ? sitemap : undefined}
	data-scope={scope}
	data-exclude={exclude?.join(',')}
>
	<!-- Крупный код -- картинка, а не заголовок: читалки её пропускают и начинают с `<h1>`. -->
	<p class="not-found__code" aria-hidden="true">
		<span>4</span>
		<svg class="not-found__mark" viewBox={MARK_VIEWBOX} fill="currentColor">
			<path fill-rule="evenodd" d={MARK}></path>
		</svg>
		<span>4</span>
	</p>
	<h1 class="not-found__title">{title}</h1>
	<p class="not-found__text">{text}</p>
	<slot />
	<div class="not-found__actions">
		<a class="not-found__action not-found__action--primary" href={home.href}>{home.label}</a>
		{
			back && (
				<button class="not-found__action" type="button" data-not-found-back hidden>
					{back}
				</button>
			)
		}
		<slot name="actions" />
	</div>
	{
		suggest && (
			<nav class="not-found__suggest" aria-label={suggest} data-not-found-suggest hidden>
				<p class="not-found__suggest-title">{suggest}</p>
				<ul class="not-found__list" data-not-found-list />
			</nav>
		)
	}
</div>

<script>
	import { notFound } from './not-found.js'

	for (const root of document.querySelectorAll<HTMLElement>('[data-not-found]')) notFound(root)
</script>

<style>
	.not-found {
		display: grid;
		gap: var(--not-found-gap, 1rem);
		justify-items: center;
		padding: 2rem 1rem;
		text-align: center;

		&__code {
			display: flex;
			gap: 0.04em;
			align-items: center;
			margin: 0;
			font-size: clamp(5rem, 18vw, 9rem);
			font-weight: 700;
			font-variant-numeric: tabular-nums;
			line-height: 1;
			letter-spacing: -0.04em;
		}

		/* Лицо стоит вместо нуля: высотой с цифру, усы выходят за круг по бокам. */
		&__mark {
			transform-origin: 50% 70%;
			width: auto;
			height: 0.86em;
			color: var(--not-found-accent, currentColor);
			animation:
				not-found-wiggle 5s ease-in-out infinite,
				not-found-rgb-split 8s steps(1) infinite;
		}

		&__title {
			margin: 0.5rem 0 0;
			font-size: clamp(1.5rem, 4vw, 2rem);
			line-height: 1.2;
			text-wrap: balance;
		}

		&__text {
			max-width: 32rem;
			margin: 0;
			color: var(--not-found-muted, color-mix(in srgb, currentColor 72%, transparent));
			text-wrap: pretty;
		}

		&__actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			justify-content: center;
			margin-top: 1rem;
		}

		/* Свои кнопки из слота `actions` берут тот же вид по классу `not-found__action`. */
		& :global(.not-found__action) {
			cursor: pointer;
			display: inline-flex;
			align-items: center;
			min-height: 2.75rem;
			padding: 0 1.25rem;
			border: 1px solid color-mix(in srgb, currentColor 30%, transparent);
			border-radius: var(--not-found-radius, 0.5rem);
			font: inherit;
			font-weight: 500;
			color: inherit;
			text-decoration: none;
			background: none;
			transition:
				border-color 0.2s,
				background-color 0.2s;

			/* `display` выше перебил бы `hidden`, а "Назад" прячется именно им. */
			&[hidden] {
				display: none;
			}

			&:hover {
				border-color: currentColor;
			}

			&:focus-visible {
				outline: 2px solid var(--not-found-accent, currentColor);
				outline-offset: 2px;
			}
		}

		& :global(.not-found__action--primary) {
			border-color: var(--not-found-accent, currentColor);
			color: var(--not-found-accent, currentColor);

			&:hover {
				background: color-mix(in srgb, var(--not-found-accent, currentColor) 12%, transparent);
			}
		}

		&__suggest {
			margin-top: 1.5rem;
		}

		&__suggest-title {
			margin: 0 0 0.5rem;
			font-size: 0.875em;
			color: var(--not-found-muted, color-mix(in srgb, currentColor 72%, transparent));
		}

		&__list {
			display: grid;
			gap: 0.25rem;
			margin: 0;
			padding: 0;
			list-style: none;

			& :global(.not-found__link) {
				color: var(--not-found-accent, currentColor);
				text-underline-offset: 0.2em;
				overflow-wrap: anywhere;
			}
		}
	}

	/* Те же движения, что у лица в credit: раз в пять секунд шевелит усами,
	   раз в восемь расслаивается на красную и бирюзовую копии. */
	@keyframes not-found-wiggle {
		0%,
		86%,
		100% {
			transform: rotate(0);
		}

		88% {
			transform: rotate(-14deg);
		}

		90% {
			transform: rotate(12deg);
		}

		92% {
			transform: rotate(-9deg);
		}

		94% {
			transform: rotate(6deg);
		}

		96% {
			transform: rotate(-3deg);
		}
	}

	@keyframes not-found-rgb-split {
		0%,
		88%,
		100% {
			filter: none;
		}

		89% {
			filter: drop-shadow(-0.04em 0 rgb(255 0 90 / 70%)) drop-shadow(0.04em 0 rgb(0 210 255 / 70%));
		}

		90.5% {
			filter: drop-shadow(0.04em 0 rgb(255 0 90 / 70%)) drop-shadow(-0.04em 0 rgb(0 210 255 / 70%));
		}

		92% {
			filter: drop-shadow(-0.02em 0 rgb(255 0 90 / 50%)) drop-shadow(0.02em 0 rgb(0 210 255 / 50%));
		}

		93% {
			filter: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.not-found__mark {
			animation: none;
		}

		.not-found :global(.not-found__action) {
			transition: none;
		}
	}
</style>
