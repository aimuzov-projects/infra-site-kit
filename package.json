{
	"name": "@aimuzov-projects/infra-site-kit",
	"version": "1.10.0",
	"private": true,
	"description": "Shared Prettier, Stylelint, oxlint and Playwright configs, the author credit, the not-found page, the theme switch and peek and Yandex Metrika for the aimuzov-projects sites",
	"license": "MIT",
	"repository": "github:aimuzov-projects/infra-site-kit",
	"type": "module",
	"exports": {
		"./prettier": "./prettier.mjs",
		"./stylelint": "./stylelint.mjs",
		"./oxlint.json": "./oxlint.json",
		"./credit.astro": "./site/credit.astro",
		"./credit.svelte": {
			"types": "./site/credit.svelte.d.ts",
			"svelte": "./site/credit.svelte",
			"default": "./site/credit.svelte"
		},
		"./year.js": "./site/year.js",
		"./mark.js": {
			"types": "./site/mark.d.ts",
			"default": "./site/mark.js"
		},
		"./sitemap.js": {
			"types": "./site/sitemap.d.ts",
			"default": "./site/sitemap.js"
		},
		"./not-found.astro": "./site/not-found.astro",
		"./not-found.js": {
			"types": "./site/not-found.d.ts",
			"default": "./site/not-found.js"
		},
		"./theme-peek.js": {
			"types": "./site/theme-peek.d.ts",
			"default": "./site/theme-peek.js"
		},
		"./theme-peek.css": "./site/theme-peek.css",
		"./theme.js": {
			"types": "./site/theme.d.ts",
			"default": "./site/theme.js"
		},
		"./theme-boot.astro": "./site/theme-boot.astro",
		"./metrika.astro": "./site/metrika.astro",
		"./metrika-pixel.astro": "./site/metrika-pixel.astro",
		"./playwright": {
			"types": "./playwright/config.d.mts",
			"default": "./playwright/config.mjs"
		},
		"./playwright/checks": {
			"types": "./playwright/checks.d.mts",
			"default": "./playwright/checks.mjs"
		}
	},
	"files": [
		"prettier.mjs",
		"stylelint.mjs",
		"oxlint.json",
		"playwright",
		"site"
	],
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "node --test 'test/*.test.mjs'",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@axe-core/playwright": "4.13.0",
		"@ianvs/prettier-plugin-sort-imports": "4.7.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"postcss-html": "2.0.0",
		"prettier-plugin-astro": "1.1.0",
		"prettier-plugin-svelte": "4.1.1",
		"stylelint-config-clean-order": "10.0.0",
		"stylelint-order": "8.1.1"
	},
	"peerDependencies": {
		"@playwright/test": "^1.64.0",
		"astro": "^7.0.0",
		"oxlint": "^1.87.0",
		"prettier": "^3.9.0",
		"stylelint": "^17.16.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@playwright/test": "1.64.0",
		"oxlint": "1.87.0",
		"prettier": "3.9.9",
		"stylelint": "17.16.0"
	},
	"keywords": [
		"astro-component",
		"svelte"
	],
	"peerDependenciesMeta": {
		"@playwright/test": {
			"optional": true
		},
		"astro": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	}
}
