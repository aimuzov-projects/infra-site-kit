{
	"name": "@aimuzov-projects/infra-site-kit",
	"version": "1.1.1",
	"private": true,
	"description": "Shared Prettier, Stylelint and oxlint configs for the aimuzov-projects sites",
	"license": "MIT",
	"repository": "github:aimuzov-projects/infra-site-kit",
	"type": "module",
	"exports": {
		"./prettier": "./prettier.mjs",
		"./stylelint": "./stylelint.mjs",
		"./oxlint.json": "./oxlint.json"
	},
	"files": [
		"prettier.mjs",
		"stylelint.mjs",
		"oxlint.json"
	],
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "node --test 'test/*.test.mjs'"
	},
	"dependencies": {
		"@ianvs/prettier-plugin-sort-imports": "4.7.1",
		"postcss-html": "2.0.0",
		"prettier-plugin-astro": "1.1.0",
		"prettier-plugin-svelte": "4.1.1",
		"stylelint-config-clean-order": "10.0.0",
		"stylelint-order": "8.1.1"
	},
	"peerDependencies": {
		"oxlint": "^1.87.0",
		"prettier": "^3.9.0",
		"stylelint": "^17.16.0"
	},
	"devDependencies": {
		"oxlint": "1.87.0",
		"prettier": "3.9.9",
		"stylelint": "17.16.0"
	}
}
