{
	"name": "@aimuzov-projects/infra-site-kit",
	"version": "1.4.1",
	"private": true,
	"description": "Shared Prettier, Stylelint and oxlint configs and the author credit for the aimuzov-projects sites",
	"license": "MIT",
	"repository": "github:aimuzov-projects/infra-site-kit",
	"type": "module",
	"exports": {
		"./prettier": "./prettier.mjs",
		"./stylelint": "./stylelint.mjs",
		"./oxlint.json": "./oxlint.json",
		"./credit.astro": "./site/credit.astro",
		"./credit.svelte": {
			"types": "./site/credit.svelte.d.ts",
			"svelte": "./site/credit.svelte",
			"default": "./site/credit.svelte"
		},
		"./year.js": "./site/year.js"
	},
	"files": [
		"prettier.mjs",
		"stylelint.mjs",
		"oxlint.json",
		"site"
	],
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "node --test 'test/*.test.mjs'"
	},
	"dependencies": {
		"@ianvs/prettier-plugin-sort-imports": "4.7.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"postcss-html": "2.0.0",
		"prettier-plugin-astro": "1.1.0",
		"prettier-plugin-svelte": "4.1.1",
		"stylelint-config-clean-order": "10.0.0",
		"stylelint-order": "8.1.1"
	},
	"peerDependencies": {
		"oxlint": "^1.87.0",
		"prettier": "^3.9.0",
		"stylelint": "^17.16.0",
		"astro": "^7.0.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"oxlint": "1.87.0",
		"prettier": "3.9.9",
		"stylelint": "17.16.0"
	},
	"keywords": [
		"astro-component",
		"svelte"
	],
	"peerDependenciesMeta": {
		"astro": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	}
}
